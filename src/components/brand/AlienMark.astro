---
/** The gym's mark: the green alien head from its posters, redrawn as a vector. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 100 113.8" aria-hidden="true">
  <path
    d="M50 110.7C18.3 92.4 3.1 66.1 3.1 47.3 3.1 13.8 32.1 3.1 50 3.1s46.9 10.7 46.9 44.2c0 18.8-15.2 45.1-46.9 63.4Z"
    fill="var(--tatami)"
    stroke="var(--green)"
    stroke-width="6.5"
    stroke-linejoin="round"></path>
  <path
    d="M12.1 44.6c30.1 0 33.7 22.8 33.7 30.6-23.5 0-33.7-16-33.7-30.6ZM87.9 44.6c-30.1 0-33.7 22.8-33.7 30.6 23.5 0 33.7-16 33.7-30.6Z"
    fill="var(--green)"></path>
</svg>
