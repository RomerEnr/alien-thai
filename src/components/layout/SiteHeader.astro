---
import Wordmark from '@/components/brand/Wordmark.astro';
import { CTA } from '@/config/site';
import MenuToggle from './MenuToggle.astro';
---

<header class="site-header" data-site-header>
  <MenuToggle />
  <Wordmark />
  <a class="cta" href={CTA.trialClass.href} data-menu-inert>{CTA.trialClass.label}</a>
</header>

<script>
  import { initSiteHeader } from '@/scripts/features/site-header';

  initSiteHeader();
</script>

<style>
  /* Transparent over the hero, then solid and compact once the page scrolls. */
  .site-header {
    --wordmark-size: 30px;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--nav-h);
    padding: 0 var(--gutter);
    border-bottom: 1px solid transparent;
    transition: height 0.4s var(--ease-out), background-color 0.4s, border-color 0.4s;
  }

  .site-header.is-solid {
    --nav-h: var(--nav-h-solid);
    --wordmark-size: 24px;
    background: rgb(var(--shade) / 0.94);
    border-color: var(--line);
    backdrop-filter: blur(8px);
  }

  .site-header > :global(.wordmark) { justify-self: center; }

  .cta {
    justify-self: end;
    padding: 12px 0;
    border-bottom: 1px solid var(--green);
    font: 500 12px / 1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .cta:hover { color: var(--green); }

  @media (--upto-phone) {
    .site-header { --wordmark-size: 21px; }
    .site-header.is-solid { --wordmark-size: 19px; }
    .cta {
      font-size: 11px;
      letter-spacing: 0.04em;
    }
  }
</style>
