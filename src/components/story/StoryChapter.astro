---
import { render, type CollectionEntry } from 'astro:content';
import ChapterNumeral from './ChapterNumeral.astro';

interface Props {
  chapter: CollectionEntry<'story'>;
}

const { chapter } = Astro.props;
const { title, order, numeral } = chapter.data;
const { Content } = await render(chapter);
---

<li class="chapter" data-story-chapter>
  <div class="body">
    <ChapterNumeral value={order} image={numeral.src} scale={numeral.scale} />
    <h3>{title}</h3>
    <div class="text"><Content /></div>
  </div>
</li>

<style>
  .body {
    display: grid;
    grid-template-columns: var(--numeral-col) minmax(0, 1fr);
    column-gap: var(--numeral-gap);
  }
  .body > :global(.numeral) { grid-row: span 2; }

  /* The numeral of the chapter being read lights up (scripts/features/story-chapters.ts). */
  .body :global(.numeral img) {
    opacity: 0.38;
    filter: saturate(0.35) brightness(0.75);
    transition: opacity 0.5s, filter 0.5s;
  }
  .chapter:global(.is-current) .body :global(.numeral img),
  :global(html:not(.js)) .body :global(.numeral img) {
    opacity: 1;
    filter: drop-shadow(0 0 14px rgb(171 214 77 / 0.35));
  }

  h3 {
    margin: 0 0 12px;
    font: 900 clamp(1.9rem, 3.2vw, 3rem) / 0.92 var(--display);
    text-transform: uppercase;
  }

  .text :global(p) {
    max-width: 44ch;
    margin: 0;
    color: var(--wall-dim);
    font-size: 17px;
  }
  .text :global(q) { color: var(--wall); }

  /* Tablets and phones: one screen per chapter; its text pins in the lower
     half, over the film's dark wash, then leaves with its screen. */
  @media (--upto-tablet) {
    .chapter { min-height: 130svh; }
    .body {
      position: sticky;
      top: 52svh;
      grid-template-columns: 1fr;
    }
    .body > :global(.numeral) {
      grid-row: auto;
      margin-bottom: 6px;
    }
    .body :global(.numeral img) {
      opacity: 1;
      filter: drop-shadow(0 0 14px rgb(171 214 77 / 0.35));
    }
    h3 { font-size: clamp(2.2rem, 10vw, 3rem); }
    .text :global(p) {
      font-size: 16px;
      color: rgb(239 235 223 / 0.86);
    }
  }
</style>
