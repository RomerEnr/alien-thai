---
import InstagramLink from '@/components/ui/InstagramLink.astro';
import { SITE } from '@/config/site';
import { getDiscipline } from '@/lib/content';
import { joinWithDots } from '@/lib/text';

const { schedule } = (await getDiscipline(SITE.headlineDiscipline)).data;
---

<div class="strip">
  <span><span class="key">Dónde</span><b>{SITE.address.street}</b> · {SITE.address.town}</span>
  {schedule.days && <span><span class="key">Thai</span><b>{joinWithDots(schedule.days)}</b></span>}
  {
    schedule.hours && (
      <span>
        <span class="key">Horas</span>
        {schedule.hours.map((range, i) => (
          <>
            {i > 0 && ' · '}
            <b>{range}</b>
          </>
        ))}
      </span>
    )
  }
  <span><span class="key">Instagram</span><InstagramLink handle={SITE.instagram} owner={SITE.name} variant="inline" /></span>
</div>

<style>
  .strip {
    grid-row: 2;
    display: flex;
    align-items: center;
    min-height: var(--strip-h);
    padding: 0 var(--gutter) env(safe-area-inset-bottom);
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: var(--tatami);
    font: 400 11px / 1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wall-dim);
  }
  .strip > * {
    padding: 16px 24px;
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .strip > :first-child {
    padding-left: 0;
    border-left: 0;
  }
  b {
    color: var(--wall);
    font-weight: 500;
  }
  .key {
    color: var(--teal);
    margin-right: 0.6em;
  }

  @media (--upto-phone) {
    .strip {
      flex-wrap: wrap;
      padding-top: 6px;
      padding-bottom: max(10px, env(safe-area-inset-bottom));
    }
    .strip > * {
      padding: 7px 14px 7px 0;
      border: 0;
    }
  }
</style>
