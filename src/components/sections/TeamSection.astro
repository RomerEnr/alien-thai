---
import Section from '@/components/layout/Section.astro';
import SectionIntro from '@/components/layout/SectionIntro.astro';
import TeamMemberCard from '@/components/team/TeamMemberCard.astro';
import { TEAM_COPY } from '@/config/copy';
import { getTeachers } from '@/lib/content';

const HEADING_ID = 'equipo-heading';
const teachers = await getTeachers();
---

<Section id="equipo" labelledBy={HEADING_ID}>
  <SectionIntro headingId={HEADING_ID} heading={TEAM_COPY.heading} lede={TEAM_COPY.lede} />
  <ul role="list" class="rail list" data-rail="laptop" data-reveal data-team>
    {teachers.map((teacher, index) => <TeamMemberCard teacher={teacher} index={index} />)}
  </ul>
</Section>

<script>
  import { initTeamBios } from '@/scripts/features/team-bios';
  import { initTeamFloatFallback } from '@/scripts/features/team-float';
  import { needsScrollTimelineFallback } from '@/scripts/lib/media';

  initTeamBios();
  if (needsScrollTimelineFallback()) initTeamFloatFallback();
</script>

<style>
  .list { --rail-item: min(70vw, 360px); }

  /* Desktop: three portraits that drift apart as the row scrolls past. */
  @media (--from-laptop) {
    .list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--card-gap);
    }
    .list > :global(*) { --float: calc(var(--i) * 26px); }
  }

  @supports (animation-timeline: view()) {
    @media (--from-laptop) and (--motion-ok) {
      .list { view-timeline: --team block; }
      .list > :global(*) {
        animation: float linear both;
        animation-timeline: --team;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  /* Phones: the cards stack. Each pins under the nav and the next one slides
     up over it; the bio still opens on tap. */
  @media (--upto-phone) {
    .list {
      display: block;
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }
    .list > :global(*) {
      position: sticky;
      top: calc(var(--nav-h-solid) + 12px);
      margin-bottom: 28px;
      box-shadow: 0 -18px 40px rgb(var(--shade) / 0.55);
    }
    .list > :global(:last-child) { margin-bottom: 0; }
  }
</style>
